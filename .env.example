# Public site URL used for metadata / canonical links
NEXT_PUBLIC_SITE_URL=https://kevin-shroads.com

# Optional: Calendly, Cal.com, or other booking link
# When empty, CTAs route to /contact
NEXT_PUBLIC_BOOKING_URL=

# Optional: external form endpoint (Formspree, Basin, custom webhook, etc.)
# Defaults to /api/contact
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Server-only production contact delivery (used by /api/contact)
CONTACT_PROVIDER_URL=
CONTACT_API_KEY=
